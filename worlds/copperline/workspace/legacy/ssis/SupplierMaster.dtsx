    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\FSYS Archive Previous Drop"
      DTS:CreationName="Microsoft.FileSystemTask"
      DTS:Description="turned off 2019-11-04 when the archive share filled up. left in place."
      DTS:Disabled="True"
      DTS:DTSID="{8C50E7F2-B913-4A6D-8E27-6D1F0B94C3A8}"
      DTS:ExecutableType="Microsoft.FileSystemTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="FSYS Archive Previous Drop">
      <DTS:ObjectData>
        <FileSystemData
          TaskOperationType="MoveFile"
          TaskSourceType="Variable"
          TaskSourceVariable="User::DropFileName"
          TaskDestinationType="Variable"
          TaskDestinationVariable="User::ArchiveFolder"
          OverwriteDestFile="True"/>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DFT Extract Suppliers"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:DTSID="{D3A72E15-9F60-4C83-A7B1-05E2C48D9036}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Extract Suppliers">
      <DTS:ObjectData>
        <pipeline>
          <components>
            <component
              refId="Package\DFT Extract Suppliers\OLE_SRC Suppliers"
              componentClassID="Microsoft.OLEDBSource"
              name="OLE_SRC Suppliers">
              <properties>
                <property name="AccessMode" dataType="System.Int32">2</property>
                <property name="SqlCommand" dataType="System.String">SELECT  v.VendorNo          AS supplier_id,
        LTRIM(RTRIM(v.VendorName)) AS supplier_name,
        v.StatusCode        AS vendor_status,
        t.TermsCode         AS payment_terms,
        v.LeadTimeDays      AS lead_time_days,
        v.CountryISO2       AS country,
        v.LastMaintDate     AS updated_on
FROM    dbo.Vendor v
        LEFT JOIN dbo.VendorTerms t ON t.VendorNo = v.VendorNo
WHERE   v.RecordStatus &lt;&gt; 'X'
ORDER BY v.VendorNo;</property>
              </properties>
              <connections>
                <connection
                  refId="Package\DFT Extract Suppliers\OLE_SRC Suppliers.Connections[OleDbConnection]"
                  connectionManagerID="{5C7A1F04-2B88-4C3D-9E11-4A0D8F6B22C7}"
                  connectionManagerRefId="Package.ConnectionManagers[ERP_PROD]"
                  name="OleDbConnection"/>
              </connections>
            </component>
            <component
              refId="Package\DFT Extract Suppliers\DER Clean Fields"
              componentClassID="Microsoft.DerivedColumn"
              name="DER Clean Fields">
              <properties>
                <property name="Note" dataType="System.String">status codes come out of the ERP padded. the Pentaho side trims again but do not rely on that.</property>
              </properties>
              <outputs>
                <output refId="Package\DFT Extract Suppliers\DER Clean Fields.Outputs[Derived Column Output]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\DFT Extract Suppliers\DER Clean Fields.Outputs[Derived Column Output].Columns[vendor_status]"
                      name="vendor_status"
                      dataType="wstr"
                      length="8">
                      <properties>
                        <property name="Expression" dataType="System.String">UPPER(TRIM(vendor_status))</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\DFT Extract Suppliers\DER Clean Fields.Outputs[Derived Column Output].Columns[country]"
                      name="country"
                      dataType="wstr"
                      length="2">
                      <properties>
                        <property name="Expression" dataType="System.String">ISNULL(country) ? "US" : UPPER(TRIM(country))</property>
                      </properties>
                    </outputColumn>
                  </outputColumns>
                </output>
              </outputs>
            </component>
            <component
              refId="Package\DFT Extract Suppliers\RC Count Rows"
              componentClassID="Microsoft.RowCount"
              name="RC Count Rows">
              <properties>
                <property name="VariableName" dataType="System.String">User::RowsWritten</property>
              </properties>
            </component>
            <component
              refId="Package\DFT Extract Suppliers\FF_DST SupplierDrop"
              componentClassID="Microsoft.FlatFileDestination"
              name="FF_DST SupplierDrop">
              <properties>
                <property name="Overwrite" dataType="System.Boolean">true</property>
                <property name="Header" dataType="System.String"/>
              </properties>
              <connections>
                <connection
                  refId="Package\DFT Extract Suppliers\FF_DST SupplierDrop.Connections[FlatFileConnection]"
                  connectionManagerID="{A1D4E7B9-33C2-4F80-B5AE-902C7D14F338}"
                  connectionManagerRefId="Package.ConnectionManagers[SupplierDrop]"
                  name="FlatFileConnection"/>
              </connections>
            </component>
          </components>
          <paths>
            <path
              refId="Package\DFT Extract Suppliers.Paths[src to der]"
              name="src to der"
              startId="Package\DFT Extract Suppliers\OLE_SRC Suppliers.Outputs[OLE DB Source Output]"
              endId="Package\DFT Extract Suppliers\DER Clean Fields.Inputs[Derived Column Input]"/>
            <path
              refId="Package\DFT Extract Suppliers.Paths[der to count]"
              name="der to count"
              startId="Package\DFT Extract Suppliers\DER Clean Fields.Outputs[Derived Column Output]"
              endId="Package\DFT Extract Suppliers\RC Count Rows.Inputs[Row Count Input]"/>
            <path
              refId="Package\DFT Extract Suppliers.Paths[count to file]"
              name="count to file"
              startId="Package\DFT Extract Suppliers\RC Count Rows.Outputs[Row Count Output]"
              endId="Package\DFT Extract Suppliers\FF_DST SupplierDrop.Inputs[Flat File Destination Input]"/>
          </paths>
        </pipeline>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Log Row Count"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{0B4C8D71-3E29-4A05-9C6F-71D3B8E204AF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
