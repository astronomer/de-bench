          SQLTask:Connection="{7E2B9C10-6F41-4A6B-8C05-1D93B4E7A662}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.PackageRunLog (PackageName, RunDate, Outcome, RowCountOut) VALUES ('SupplierMaster', GETDATE(), 'OK', ?);">
