    <DTS:ConnectionManager
      DTS:refId="Package.ConnectionManagers[SupplierDrop]"
      DTS:CreationName="FLATFILE"
      DTS:DTSID="{A1D4E7B9-33C2-4F80-B5AE-902C7D14F338}"
      DTS:ObjectName="SupplierDrop"
      DTS:Description="pipe delimited, no quotes, 1252. the Pentaho side reads this.">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ColumnDelimiter="|"
          DTS:CodePage="1252"
          DTS:Format="Delimited"
          DTS:HeaderRowDelimiter="_x000D__x000A_"
          DTS:RowDelimiter="_x000D__x000A_"
          DTS:ColumnNamesInFirstDataRow="True"
          DTS:ConnectionString="\\cplfs01\interfaces\out\supplier_master.csv"/>
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables>
    <DTS:Variable
      DTS:refId="Package.Variables[User::DropFolder]"
      DTS:CreationName=""
      DTS:DTSID="{2C55A8E1-9B3F-42D7-8A16-C40B9E1D7745}"
      DTS:Namespace="User"
      DTS:ObjectName="DropFolder">
      <DTS:VariableValue DTS:DataType="8">\\cplfs01\interfaces\out</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:refId="Package.Variables[User::BusinessDate]"
      DTS:CreationName=""
      DTS:DTSID="{6D0F3B72-1E48-4C9A-B233-58E7A0C1F914}"
      DTS:Namespace="User"
      DTS:ObjectName="BusinessDate"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR,4)YEAR(DATEADD(&quot;dd&quot;,-1,GETDATE())) + &quot;-&quot; + RIGHT(&quot;0&quot; + (DT_WSTR,2)MONTH(DATEADD(&quot;dd&quot;,-1,GETDATE())),2) + &quot;-&quot; + RIGHT(&quot;0&quot; + (DT_WSTR,2)DAY(DATEADD(&quot;dd&quot;,-1,GETDATE())),2)">
      <DTS:VariableValue DTS:DataType="8"/>
    </DTS:Variable>
    <DTS:Variable
      DTS:refId="Package.Variables[User::DropFileName]"
      DTS:CreationName=""
      DTS:DTSID="{B7241C6E-05AA-4E39-9D80-3F16C2B4A5D1}"
      DTS:Namespace="User"
      DTS:ObjectName="DropFileName"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="@[User::DropFolder] + &quot;\\supplier_master_&quot; + @[User::BusinessDate] + &quot;.csv&quot;">
      <DTS:VariableValue DTS:DataType="8"/>
    </DTS:Variable>
    <DTS:Variable
      DTS:refId="Package.Variables[User::RowsWritten]"
      DTS:CreationName=""
      DTS:DTSID="{4F98D0A3-7C21-4B55-93E6-8A0D5C7B1E20}"
      DTS:Namespace="User"
