  <hops>
    <hop>
      <from>START</from>
      <to>set_constants</to>
      <from_nr>0</from_nr>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>set_constants</from>
      <to>resolve_load_control</to>
      <from_nr>0</from_nr>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>resolve_load_control</from>
      <to>load_inventory</to>
      <from_nr>0</from_nr>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>load_inventory</from>
      <to>load_movements</to>
      <from_nr>0</from_nr>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>load_movements</from>
      <to>load_carrier_scans</to>
      <from_nr>0</from_nr>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>load_carrier_scans</from>
