<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>nightly_load</name>
  <description>Copperline nightly load. One invocation per job name.</description>
  <extended_description>Called once per legacy job. The scheduler passes JOB_NAME and
BUSINESS_DATE. Everything else is resolved at run time: set_constants reads the site
settings, resolve_load_control reads the control row for the night and exports the load
context, the four load steps consume it, history_complete closes the bracket for the whole
job. Do not close the bracket per step.</extended_description>
  <job_version>3.2</job_version>
  <job_status>0</job_status>
  <directory>/copperline/nightly</directory>
  <created_user>amireles</created_user>
  <created_date>2019/03/11 22:41:08.412</created_date>
  <modified_user>amireles</modified_user>
  <modified_date>2021/06/02 17:14:55.108</modified_date>
  <parameters>
    <parameter>
      <name>JOB_NAME</name>
      <default_value/>
      <description>one of the nightly job names, e.g. nightly_stock_ledger</description>
    </parameter>
    <parameter>
      <name>BUSINESS_DATE</name>
      <default_value/>
      <description>the night being loaded, yyyy-MM-dd. AutoSys passes %AUTO_DATE%.</description>
    </parameter>
  </parameters>
  <connection>
    <name>copperline_wh</name>
    <server>${CPL_WH_HOST}</server>
    <type>GENERIC</type>
    <access>Native</access>
    <database>${CPL_WH_DB}</database>
    <port>0</port>
    <username>${CPL_WH_USER}</username>
    <password>Encrypted 2be98afc86aa7f2e4cb14a9d61c2f8b1c</password>
    <attributes>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <entries>
    <entry>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>96</xloc>
      <yloc>64</yloc>
    </entry>
    <entry>
      <name>set_constants</name>
      <description>site settings: staging schema and watermark column</description>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/trn/set_constants.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <cluster>N</cluster>
      <slave_server_name/>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>Pentaho local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>224</xloc>
      <yloc>64</yloc>
    </entry>
    <entry>
      <name>resolve_load_control</name>
