<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>load_supplier_master</name>
    <description>picks up the file the SSIS package drops</description>
    <extended_description/>
    <trans_version>1.2</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/copperline/nightly/trn</directory>
    <parameters/>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <created_user>amireles</created_user>
    <created_date>2021/02/08 13:26:04.902</created_date>
    <modified_user>kduffy</modified_user>
    <modified_date>2021/09/30 10:11:47.339</modified_date>
  </info>
  <connection>
    <name>copperline_wh</name>
    <server>${CPL_WH_HOST}</server>
    <type>GENERIC</type>
    <access>Native</access>
    <database>${CPL_WH_DB}</database>
    <port>0</port>
    <username>${CPL_WH_USER}</username>
    <password>Encrypted 2be98afc86aa7f2e4cb14a9d61c2f8b1c</password>
  </connection>
  <order>
    <hop><from>supplier_master csv</from><to>stamp the load</to><enabled>Y</enabled></hop>
    <hop><from>stamp the load</from><to>write staging</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>supplier_master csv</name>
    <type>CsvInput</type>
    <description>SSIS drops this at 00:40. if it is late the step gets nothing and the job
carries on, which is wrong but nobody has asked for it to change.</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${CPL_IFACE_IN}/supplier_master_${BUSINESS_DATE}.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>|</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>Y</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>windows-1252</encoding>
    <fields>
      <field><name>supplier_id</name><type>String</type><format/><currency/><decimal/><group/><length>12</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>supplier_name</name><type>String</type><format/><currency/><decimal/><group/><length>120</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>vendor_status</name><type>String</type><format/><currency/><decimal/><group/><length>8</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>payment_terms</name><type>String</type><format/><currency/><decimal/><group/><length>12</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>lead_time_days</name><type>Integer</type><format>#</format><currency/><decimal/><group/><length>-1</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>country</name><type>String</type><format/><currency/><decimal/><group/><length>2</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>updated_on</name><type>Date</type><format>yyyy-MM-dd</format><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <cluster_schema/>
    <GUI><xloc>112</xloc><yloc>96</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>stamp the load</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <name>load_id</name>
        <variable>${LOAD_ID}</variable>
        <type>Integer</type>
        <format>#</format>
        <currency/><decimal/><group/>
        <length>-1</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>stream_name</name>
        <variable>${STREAM_NAME}</variable>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <cluster_schema/>
    <GUI><xloc>304</xloc><yloc>96</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>write staging</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>copperline_wh</connection>
    <schema>${STAGING_SCHEMA}</schema>
    <table>supplier_master</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields/>
    <cluster_schema/>
    <GUI><xloc>496</xloc><yloc>96</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
