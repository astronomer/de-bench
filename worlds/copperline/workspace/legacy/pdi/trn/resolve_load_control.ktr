<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>resolve_load_control</name>
    <description>Resolves the load context for one job and one night.</description>
    <extended_description>Reads the open row in ops.load_control for JOB_NAME and
BUSINESS_DATE, and exports four variables to the parent job: LOAD_ID, STREAM_NAME,
LOAD_FROM_COLUMN and LOAD_FROM. The mark the load steps cut from is the mark the previous
night reached, which is why the join goes back a day. The same row is stamped with the
context this run is using, so that the table says afterwards what the run did.

Nothing downstream may query this table again. Query it once, here.</extended_description>
    <trans_version>2.1</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/copperline/nightly/trn</directory>
    <parameters/>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <created_user>amireles</created_user>
    <created_date>2019/03/12 10:02:44.118</created_date>
    <modified_user>amireles</modified_user>
    <modified_date>2021/06/02 16:58:20.443</modified_date>
  </info>
  <connection>
    <name>copperline_wh</name>
    <server>${CPL_WH_HOST}</server>
    <type>GENERIC</type>
    <access>Native</access>
    <database>${CPL_WH_DB}</database>
    <port>0</port>
    <username>${CPL_WH_USER}</username>
    <password>Encrypted 2be98afc86aa7f2e4cb14a9d61c2f8b1c</password>
  </connection>
  <order>
    <hop><from>read control row</from><to>export to job</to><enabled>Y</enabled></hop>
    <hop><from>read control row</from><to>stamp the row</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>read control row</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>copperline_wh</connection>
    <sql>SELECT c.load_id
     , c.stream_name
     , coalesce(p.watermark_column, '${WATERMARK_COLUMN}') AS load_from_column
     , p.watermark_value                                   AS load_from
  FROM ops.load_control c
  LEFT JOIN ops.load_control p
         ON p.job_name      = c.job_name
        AND p.business_date = c.business_date - INTERVAL 1 DAY
 WHERE c.job_name      = '${JOB_NAME}'
   AND c.business_date = DATE '${BUSINESS_DATE}'
 LIMIT 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI><xloc>112</xloc><yloc>96</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>export to job</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <variable_name>LOAD_ID</variable_name>
        <field_name>load_id</field_name>
        <variable_type>PARENT_JOB</variable_type>
        <default_value/>
      </field>
      <field>
        <variable_name>STREAM_NAME</variable_name>
        <field_name>stream_name</field_name>
        <variable_type>PARENT_JOB</variable_type>
        <default_value/>
      </field>
      <field>
        <variable_name>LOAD_FROM_COLUMN</variable_name>
        <field_name>load_from_column</field_name>
        <variable_type>PARENT_JOB</variable_type>
        <default_value/>
      </field>
      <field>
        <variable_name>LOAD_FROM</variable_name>
        <field_name>load_from</field_name>
        <variable_type>PARENT_JOB</variable_type>
        <default_value/>
      </field>
    </fields>
    <usevar>N</usevar>
    <cluster_schema/>
    <GUI><xloc>320</xloc><yloc>48</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>stamp the row</name>
    <type>ExecSQL</type>
    <description>records the context this run is using</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>copperline_wh</connection>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <sql>UPDATE ops.load_control
   SET staging_schema   = '${STAGING_SCHEMA}'
     , watermark_column = nullif('${WATERMARK_COLUMN}', '')
     , watermark_value  = CASE WHEN '${WATERMARK_COLUMN}' = '' THEN NULL
                               ELSE business_date + INTERVAL 1 DAY - INTERVAL 1 MINUTE
                          END
     , started_at       = now()
     , load_status      = 'running'
 WHERE load_id = ?</sql>
    <arguments>
      <argument><name>load_id</name></argument>
    </arguments>
    <cluster_schema/>
    <GUI><xloc>320</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
