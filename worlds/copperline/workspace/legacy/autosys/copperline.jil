/* ===================================================================== */
/*  Copperline nightly, AutoSys R11.3.6                                  */
/*  autorep -J cpl.% -q  >  copperline.jil                               */
/*  exported 12/18/2025 13:58 from CPLSCHED01 by dwops                   */
/*                                                                       */
/*  BUSDATE is set in /opt/cpl/etc/nightly.profile. It is yesterday in    */
/*  yyyy-mm-dd, which is the format the Pentaho job wants.                */
/*                                                                       */
/*  Calendar retail_2026 is in calendars/retail_2026.cal. Load it with    */
/*  autocal_asc -i before you apply this file, or the boxes that name it  */
/*  will not start.                                                       */
/* ===================================================================== */


/* ---- wave 1. cut over 2026-01-05, these run in Airflow now. ---- */
/* ---- left here so the next wave can see what came out. KD  ---- */

delete_job: cpl.nightly_supplier_master
delete_job: cpl.nightly_inventory_report
delete_job: cpl.nightly_dc_transfer
delete_job: cpl.nightly_shrink_weekly
delete_job: cpl.nightly_lane_performance
delete_job: cpl.nightly_backorder
delete_job: cpl.nightly_dc_capacity
delete_job: cpl.nightly_scorecard
delete_job: cpl.nightly_fill_rate


/* ===================================================================== */
/*  the window                                                           */
/* ===================================================================== */

insert_job: cpl.nightly   job_type: b
owner: dwops@cplsched01
permission: gx,ge,wx,we
date_conditions: 1
days_of_week: all
start_times: "01:00"
description: "Copperline nightly window"
alarm_if_fail: 1
max_run_alarm: 300

insert_job: cpl.nightly.stage   job_type: b
box_name: cpl.nightly
owner: dwops@cplsched01
permission: gx,ge
description: "land the night's files and extracts"
alarm_if_fail: 1

insert_job: cpl.nightly.load   job_type: b
box_name: cpl.nightly
condition: s(cpl.nightly.stage)
owner: dwops@cplsched01
permission: gx,ge
description: "the Pentaho jobs"
alarm_if_fail: 1

insert_job: cpl.nightly.recon   job_type: b
box_name: cpl.nightly
condition: s(cpl.nightly.load)
owner: dwops@cplsched01
permission: gx,ge
run_calendar: retail_2026
description: "tie outs. trading days only, finance do not read them at the weekend"
alarm_if_fail: 1

insert_job: cpl.nightly.dist   job_type: b
box_name: cpl.nightly
condition: s(cpl.nightly.recon)
owner: dwops@cplsched01
permission: gx,ge
run_calendar: retail_2026
description: "packs out to the shares"
alarm_if_fail: 1


/* ===================================================================== */
/*  staging                                                              */
/* ===================================================================== */

insert_job: cpl.stage.pos   job_type: b
box_name: cpl.nightly.stage
owner: dwops@cplsched01
permission: gx,ge
description: "store batches"
alarm_if_fail: 1

insert_job: cpl.stage.pos.watch   job_type: f
box_name: cpl.stage.pos
machine: cplbatch01
owner: dwops@cplbatch01
watch_file: /data/landing/pos/pos_batch_${BUSDATE}.trg
watch_interval: 60
term_run_time: 210
description: "the last store closes 23:05 local. Hawaii is the long pole."

insert_job: cpl.stage.pos.batch   job_type: c
box_name: cpl.stage.pos
condition: s(cpl.stage.pos.watch)
machine: cplbatch01
owner: dwops@cplbatch01
permission: gx,ge
command: /opt/cpl/bin/stage_pos.sh -d ${BUSDATE}
std_out_file: /var/log/autosys/$AUTO_JOB_NAME.out
std_err_file: /var/log/autosys/$AUTO_JOB_NAME.err
alarm_if_fail: 1
max_run_alarm: 45
n_retrys: 2

insert_job: cpl.stage.wms   job_type: b
box_name: cpl.nightly.stage
owner: dwops@cplsched01
permission: gx,ge
description: "warehouse movements"
alarm_if_fail: 1

insert_job: cpl.stage.wms.movements   job_type: c
box_name: cpl.stage.wms
machine: cplbatch01
owner: dwops@cplbatch01
permission: gx,ge
command: /opt/cpl/bin/stage_wms.sh movements ${BUSDATE}
std_out_file: /var/log/autosys/$AUTO_JOB_NAME.out
std_err_file: /var/log/autosys/$AUTO_JOB_NAME.err
alarm_if_fail: 1
max_run_alarm: 60
n_retrys: 1

insert_job: cpl.stage.erp   job_type: b
box_name: cpl.nightly.stage
owner: dwops@cplsched01
permission: gx,ge
description: "ERP pulls"
alarm_if_fail: 1

insert_job: cpl.stage.erp.gl   job_type: c
box_name: cpl.stage.erp
machine: cplbatch01
owner: dwops@cplbatch01
permission: gx,ge
command: /opt/cpl/bin/stage_erp.sh gl ${BUSDATE}
std_out_file: /var/log/autosys/$AUTO_JOB_NAME.out
std_err_file: /var/log/autosys/$AUTO_JOB_NAME.err
alarm_if_fail: 1
max_run_alarm: 90

insert_job: cpl.stage.files   job_type: b
box_name: cpl.nightly.stage
owner: dwops@cplsched01
permission: gx,ge
description: "whatever arrives on the interface share"
alarm_if_fail: 1

insert_job: cpl.stage.files.supplier   job_type: f
box_name: cpl.stage.files
machine: cplbatch01
owner: dwops@cplbatch01
watch_file: /mnt/interfaces/out/supplier_master_${BUSDATE}.csv
watch_interval: 120
term_run_time: 90
description: "the SSIS package drops this about 00:40"

insert_job: cpl.stage.files.freight   job_type: c
box_name: cpl.stage.files
machine: cplbatch01
owner: dwops@cplbatch01
permission: gx,ge
command: /opt/cpl/bin/stage_freight.sh ${BUSDATE}
std_out_file: /var/log/autosys/$AUTO_JOB_NAME.out
std_err_file: /var/log/autosys/$AUTO_JOB_NAME.err
alarm_if_fail: 1
max_run_alarm: 30


/* ===================================================================== */
